<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- ML Kit GenAI declares minSdk 26. Calls are guarded by SDK_INT checks, so
       the module stays usable (reporting "unavailable") on older devices. -->
  <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common" />
</manifest>
